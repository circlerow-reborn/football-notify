# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ENABLE_TRANSLATION=false

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=football_news

# RSS feeds (comma-separated)
RSS_FEEDS=https://www.espn.com/espn/rss/soccer/news,https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.skysports.com/rss/12040,https://www.goal.com/feeds/en/news

# Scheduler interval (minutes)
POLL_INTERVAL_MINUTES=5
